{
  "$defs": {
    "Decision": {
      "enum": [
        "auto",
        "needs_approval",
        "reject"
      ],
      "title": "Decision",
      "type": "string"
    },
    "FiredRule": {
      "properties": {
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "effect": {
          "$ref": "#/$defs/Decision"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "effect",
        "message"
      ],
      "title": "FiredRule",
      "type": "object"
    },
    "Need": {
      "description": "What the buyer asked for, in structured form (shown to the user before anything is ordered).",
      "properties": {
        "item": {
          "description": "Short description, e.g. 'lactose-free milk'.",
          "title": "Item",
          "type": "string"
        },
        "quantity": {
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Quantity",
          "type": "number"
        },
        "unit": {
          "description": "L, KG, PCS (consumer pieces) or a sales unit code such as KI.",
          "title": "Unit",
          "type": "string"
        },
        "delivery_date": {
          "format": "date",
          "title": "Delivery Date",
          "type": "string"
        },
        "search_text": {
          "default": "",
          "title": "Search Text",
          "type": "string"
        },
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "free_from": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Free From",
          "type": "array"
        },
        "exclude_allergens": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Exclude Allergens",
          "type": "array"
        },
        "exclude_terms": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Exclude Terms",
          "type": "array"
        },
        "preferred_product_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Preferred Product Ids",
          "type": "array"
        },
        "allow_partial": {
          "default": true,
          "title": "Allow Partial",
          "type": "boolean"
        }
      },
      "required": [
        "item",
        "quantity",
        "unit",
        "delivery_date"
      ],
      "title": "Need",
      "type": "object"
    },
    "PolicyResult": {
      "properties": {
        "decision": {
          "$ref": "#/$defs/Decision"
        },
        "fired_rules": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FiredRule"
          },
          "title": "Fired Rules",
          "type": "array"
        },
        "reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "mandate_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mandate Id"
        }
      },
      "required": [
        "decision"
      ],
      "title": "PolicyResult",
      "type": "object"
    },
    "QuoteLine": {
      "properties": {
        "product_id": {
          "title": "Product Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "quantity": {
          "title": "Quantity",
          "type": "number"
        },
        "sales_unit": {
          "title": "Sales Unit",
          "type": "string"
        },
        "unit_price": {
          "title": "Unit Price",
          "type": "number"
        },
        "unit_price_with_tax": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Price With Tax"
        },
        "line_total": {
          "title": "Line Total",
          "type": "number"
        },
        "closing_time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Closing Time"
        },
        "covers": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Amount of the need covered, in need units.",
          "title": "Covers"
        },
        "is_substitute": {
          "default": false,
          "title": "Is Substitute",
          "type": "boolean"
        },
        "substitute_for": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Substitute For"
        },
        "substitute_for_category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Substitute For Category"
        },
        "estimated_kg_co2e": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Kg Co2E"
        },
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country"
        },
        "availability_checked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Availability Checked At"
        },
        "available_sales_units": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Available Sales Units"
        },
        "delivery_reliability": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delivery Reliability"
        },
        "substitution_source": {
          "anyOf": [
            {
              "enum": [
                "valio_listed",
                "catalog_ingredient_match"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Substitution Source"
        }
      },
      "required": [
        "product_id",
        "quantity",
        "sales_unit",
        "unit_price",
        "line_total"
      ],
      "title": "QuoteLine",
      "type": "object"
    }
  },
  "properties": {
    "quote_id": {
      "title": "Quote Id",
      "type": "string"
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "buyer_id": {
      "title": "Buyer Id",
      "type": "string"
    },
    "delivery_date": {
      "format": "date",
      "title": "Delivery Date",
      "type": "string"
    },
    "postal_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Delivery postcode given when the quote was requested, if any.",
      "title": "Postal Code"
    },
    "lines": {
      "items": {
        "$ref": "#/$defs/QuoteLine"
      },
      "title": "Lines",
      "type": "array"
    },
    "total_net": {
      "title": "Total Net",
      "type": "number"
    },
    "total_gross": {
      "title": "Total Gross",
      "type": "number"
    },
    "currency": {
      "default": "EUR",
      "title": "Currency",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "need": {
      "anyOf": [
        {
          "$ref": "#/$defs/Need"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "policy_preview": {
      "$ref": "#/$defs/PolicyResult"
    },
    "signature": {
      "description": "Compact JWS (EdDSA/Ed25519) over the quote payload.",
      "title": "Signature",
      "type": "string"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "quote_id",
    "buyer_id",
    "delivery_date",
    "lines",
    "total_net",
    "total_gross",
    "created_at",
    "expires_at",
    "policy_preview",
    "signature"
  ],
  "title": "Quote",
  "type": "object"
}
