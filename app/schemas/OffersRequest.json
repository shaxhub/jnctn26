{
  "properties": {
    "product_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Product Ids",
      "type": "array"
    },
    "delivery_date": {
      "format": "date",
      "title": "Delivery Date",
      "type": "string"
    },
    "quantity": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional: needed amount, to also get a plan.",
      "title": "Quantity"
    },
    "unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Unit of quantity: L, KG, PCS or a sales unit code.",
      "title": "Unit"
    },
    "include_substitutes": {
      "default": false,
      "title": "Include Substitutes",
      "type": "boolean"
    },
    "required_claims": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "title": "Required Claims",
      "type": "array"
    },
    "exclude_allergens": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "title": "Exclude Allergens",
      "type": "array"
    },
    "postal_code": {
      "anyOf": [
        {
          "pattern": "^[0-9]{5}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Postal Code"
    },
    "include_next_delivery": {
      "default": false,
      "description": "Check the earliest later date reported by Valio.",
      "title": "Include Next Delivery",
      "type": "boolean"
    }
  },
  "required": [
    "product_ids",
    "delivery_date"
  ],
  "title": "OffersRequest",
  "type": "object"
}
