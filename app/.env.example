# Copy to .env and fill in. .env is gitignored.
# Valio Aimo challenge API. Leave the key blank for the synthetic demo.
VALIO_API_KEY=
VALIO_BASE_URL=https://junction26.valioaimo.fi/api
VALIO_CUSTOMER_ID=123
VALIO_CACHE_TTL_S=60

# Generate a private random key for the Aimo operations portal.
AIMO_ADMIN_API_KEY=
# Set this when serving browser-based MCP clients from a different origin.
MCP_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Folder with the challenge files (product JSON, CSVs). Never copy them into app/ or commit them.
DATA_DIR=../external/valio-aimo

# Catalog (rebuilt by load_catalog) and gateway state (quotes, orders, audit) live in separate files.
CATALOG_DB_PATH=data/catalog.db
DB_PATH=data/gateway.db
SIGNING_KEY_PATH=data/quote_signing_key.pem

# Optional: LLM mode for the reference buyer agent (falls back to deterministic scripted mode if empty)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5

# Optional: fixed Europe/Helsinki ISO timestamp for reproducible cutoff demos (e.g. 2026-11-14T10:00:00+02:00)
DEMO_NOW=

# Gemini 4 Hydrogen (Medium) for assistant input and Gemini Decision 1 for the Aimo order review.
# Leave blank for guided input and rule-based approval.
GEMINI_API_KEY=
# Aimo warehouse checks. Blank means on with OFFLINE_DEMO=1 (synthetic evidence) and off in live mode.
# Set 1 in live mode only if warehouse evidence is recorded through the admin endpoint
# PUT /operations/fulfillment-evidence/{delivery_date}/{product_id}. Orders wait for approval without it.
AIMO_FULFILLMENT_CHECKS=

# Local password accounts and synthetic offers. Use a separate catalog, database, and key for the demo.
REQUIRE_PORTAL_LOGIN=0
OFFLINE_DEMO=0
